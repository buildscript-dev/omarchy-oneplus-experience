#!/bin/bash
# Installs the oneplus-experience daemon as a user service and puts oneplus-experience-ctl on PATH.
set -euo pipefail
here="$(cd "$(dirname "$0")" && pwd)"

mkdir -p ~/.local/bin ~/.config/systemd/user
cat > ~/.local/bin/oneplus-experience-ctl <<CTL
#!/bin/sh
exec /usr/bin/python3 "$here/daemon/oneplus-experience.py" "\$@"
CTL
chmod +x ~/.local/bin/oneplus-experience-ctl "$here/daemon/oneplus-experience.py"
cp "$here/daemon/oneplus-experience.service" ~/.config/systemd/user/oneplus-experience.service

systemctl --user daemon-reload
systemctl --user enable oneplus-experience.service
systemctl --user restart oneplus-experience.service
echo "oneplus-experience is running. Status: oneplus-experience-ctl status"
