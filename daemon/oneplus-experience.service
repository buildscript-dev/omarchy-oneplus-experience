[Unit]
Description=OnePlus Buds controls for the Omarchy bar
After=bluetooth.target graphical-session.target
PartOf=graphical-session.target
ConditionPathExists=%h/.config/omarchy/plugins/io.github.buildscript-dev.oneplus-experience/daemon/oneplus-experience.py

[Service]
# The system interpreter in isolated mode: no PYTHON* variables, no user site.
ExecStart=/usr/bin/python3 -I %h/.config/omarchy/plugins/io.github.buildscript-dev.oneplus-experience/daemon/oneplus-experience.py daemon
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=yes

[Install]
WantedBy=graphical-session.target
